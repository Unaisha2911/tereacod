{
  "name": "tereacod",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "chrome >= 96",
    "edge >= 96",
    "firefox >= 95",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "and_chr >= 96"
  ],
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "bunx wrangler d1 migrations apply DB --local",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:reset": "bun scripts/seed.ts --reset",
    "db:seed:export": "bun scripts/export-d1-seed.ts",
    "db:seed:remote": "bunx wrangler d1 execute DB --remote --file scripts/seed-d1.sql",
    "db:seed:kv:remote": "bun scripts/kv-remote.ts --remote",
    "db:migrate": "bunx wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply DB --remote",
    "admin:password:verify": "bun scripts/admin-password.ts verify",
    "admin:password:set": "bun scripts/admin-password.ts set",
    "admin:password:set:remote": "bun scripts/admin-password.ts set && bunx wrangler d1 execute DB --remote --file db/set-admin-password.sql",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "bunx wrangler types",
    "assets:smoke": "bun scripts/smoke-keying.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.5",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}
